# BOT Chain testnet (verify against https://dev-docs.botchain.ai/docs/Developers/quick-guide/ before deploying)
NEXT_PUBLIC_CHAIN_ID=968
NEXT_PUBLIC_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_EXPLORER_URL=https://scan.bohr.life

# Score service. "/api" uses the one built into this app. Leave empty to run with no ranked play:
# every game stays in Practice and the interface shows its offline states.
NEXT_PUBLIC_KLYNT_API=/api

# Signs the sign-in cookie. Required in production: 32+ random characters, never committed.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KLYNT_SESSION_SECRET=

# SQLite file for sessions, scores and submissions.
KLYNT_DB_PATH=.data/klynt.db

# Reward vault contract. Leave empty until deployed and verified.
NEXT_PUBLIC_REWARD_VAULT=

# Comma-separated operator wallets. This only hides the admin UI; the API must enforce access.
NEXT_PUBLIC_ADMIN_WALLETS=
