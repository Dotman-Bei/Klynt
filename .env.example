# BOT Chain testnet (verify against https://dev-docs.botchain.ai/docs/Developers/quick-guide/ before deploying)
NEXT_PUBLIC_CHAIN_ID=968
NEXT_PUBLIC_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_EXPLORER_URL=https://scan.bohr.life

# Score service. "/api" uses the one built into this app. Leave empty to run with no ranked play:
# every game stays in Practice and the interface shows its offline states.
NEXT_PUBLIC_KLYNT_API=/api

# Signs the sign-in cookie. Required in production: 32+ random characters, never committed.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KLYNT_SESSION_SECRET=

# SQLite file for sessions, scores and submissions.
KLYNT_DB_PATH=.data/klynt.db

# Reward vault contract. Leave empty until deployed and verified.
NEXT_PUBLIC_REWARD_VAULT=

# Rewards. Off unless REWARDS_ENABLED=true and the vault and attestor are configured.
REWARDS_ENABLED=false
# Server-only signing key for claim authorisations. Never commit. Its address must be a signer on the vault.
ATTESTOR_PRIVATE_KEY=
# Decimals the server expects of the reward token; it refuses to sign if the chain disagrees.
REWARD_TOKEN_DECIMALS=18
# Whole tokens per qualifying run and per wallet per 24 h (confirm before any real season).
REWARD_PER_RUN=1
REWARD_DAILY_CAP=10

# Sign-offs for the readiness checklist on /rewards. Set each to true only after a person has checked it.
NEXT_PUBLIC_SIGNOFF_GGI_VERIFIED=false
NEXT_PUBLIC_SIGNOFF_GGI_PERMISSION=false
NEXT_PUBLIC_SIGNOFF_VAULT_VERIFIED=false
NEXT_PUBLIC_SIGNOFF_TESTNET_TESTED=false

# Comma-separated operator wallets. This only hides the admin UI; the API must enforce access.
NEXT_PUBLIC_ADMIN_WALLETS=
