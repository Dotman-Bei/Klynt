# BOT Chain testnet (verify against https://dev-docs.botchain.ai/docs/Developers/quick-guide/ before deploying)
NEXT_PUBLIC_CHAIN_ID=968
NEXT_PUBLIC_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_EXPLORER_URL=https://scan.bohr.life

# Score service. Leave empty until it is live; the interface then shows its offline states.
NEXT_PUBLIC_KLYNT_API=

# Reward vault contract. Leave empty until deployed and verified.
NEXT_PUBLIC_REWARD_VAULT=

# Comma-separated operator wallets. This only hides the admin UI; the API must enforce access.
NEXT_PUBLIC_ADMIN_WALLETS=
