# Copy to contracts/.env (git-ignored) and fill in. Forge loads it automatically.
# The deployer pays gas and becomes the vault owner. Use a wallet that holds only testnet BOT.
DEPLOYER_PRIVATE_KEY=
# Public address of the server's signing key (the app's ATTESTOR_PRIVATE_KEY). Not the deployer.
ATTESTOR_ADDRESS=
# Optional: create and fund Season 1 with this many whole testnet points.
SEASON_BUDGET=10000
BOT_TESTNET_RPC=https://rpc.bohr.life
